{:entity :productos
 :title "Productos"
 :table "productos"
 :connection :default
 :rights ["U" "A" "S"]
 :mode :parameter-driven
 :menu-order 999
 :menu-icon "bi bi-box-seam"
 
  
:fields [{:id :id        :label "ID"        :type :hidden}
         {:id :nombre    :label "Nombre"    :type :text   :placeholder "Nombre del producto..."}
         {:id :categoria :label "Categoría" :type :select
          :options [{:value ""        :label "Seleccionar..."}
                    {:value "Pizza"   :label "Pizza"}
                    {:value "Bebida"  :label "Bebida"}
                    {:value "Extra"   :label "Extra"}
                    {:value "Postre"  :label "Postre"}]}
         {:id :imagen    :label "Imagen URL" :type :file   :placeholder "https://..."}
         {:id :precio    :label "Precio"    :type :number :placeholder "0.00"}
         {:id :activo    :label "Activo"    :type :radio  :value "T"
          :options [{:id "activoT" :value "T" :label "Sí"}
                    {:id "activoF" :value "F" :label "No"}]}]

 

 




 :queries {:list "SELECT * FROM productos ORDER BY id DESC"
           :get "SELECT * FROM productos WHERE id = ?"}
 
 :actions {:new true :edit true :delete true}
 
 :hooks {:after-load :pizzabom.hooks.productos/after-load
         :before-save :pizzabom.hooks.productos/before-save}
 
 :subgrids [
           
            {:entity :producto_consumos
             :title "Inventario (via Producto Consumos)"
             :foreign-key :producto_id
             :icon "bi bi-list-ul"
             :label "Inventario (via Producto Consumos)"
             :relationship-type :many-to-many
             :through-table :producto_consumos
             :related-entity :inventario
             :related-fk :inventario_id}]}
